{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers config for the OpenNext build of this Next.js app.
	// Nothing here deploys by itself; `yarn deploy` (or a Cloudflare Git build) does.
	"name": "rapid-revenue",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cloudflare D1 database for leads and the resource library (created 2026-11-14, region APAC).
	// Production uses this database. `yarn dev` / `yarn preview` use a private local copy under .wrangler/.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rapid-revenue-db",
			"database_id": "257e7064-2c5b-4c1e-bc97-3290db8fc7c9"
		}
	],
	"observability": {
		"enabled": true
	}
	// The only secret: ADMIN_PASSWORD. Set it in the dashboard (Worker -> Settings ->
	// Variables and Secrets) or with:  npx wrangler secret put ADMIN_PASSWORD
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Workers config for the OpenNext build of this Next.js app.
	// Nothing here deploys by itself; `yarn deploy` (or a Cloudflare Git build) does.
	"name": "rapid-revenue",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Cloudflare D1 database for leads and the resource library.
	// No database_id yet: the first `yarn deploy` creates the database in your account and
	// writes its id back into this file. Locally, a private copy lives under .wrangler/.
	"d1_databases": [
		{
			"binding": "DB"
		}
	],
	"observability": {
		"enabled": true
	}
	// The only secret, set once with:  npx wrangler secret put ADMIN_PASSWORD
}

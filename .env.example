# Copy this file to `.env.development.local` and fill in real values. Never commit it.
# (Windows PowerShell:  Copy-Item .env.example .env.development.local)
# That file is only loaded by `next dev`, so local secrets are never bundled into a
# production/Cloudflare build. In production, ADMIN_PASSWORD is a Cloudflare secret.
#
# The database needs no variable: it is the Cloudflare D1 binding `DB` in wrangler.jsonc.

# Password for the /admin/login page and all /api/admin/* endpoints (server-side only).
# Use a long random value. Do not reuse the one from the Emergent export.
ADMIN_PASSWORD=

# Value sent in the Access-Control-Allow-Origin header (read at build time by next.config.js).
# "*" allows any origin; set to your site origin (e.g. https://therapidrevenue.in) for production.
CORS_ORIGINS=

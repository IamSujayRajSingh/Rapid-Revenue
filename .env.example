# Copy this file to `.env` and fill in real values. Never commit `.env`.
# (Windows PowerShell:  Copy-Item .env.example .env)

# MongoDB connection string (server-side only).
#   Local development: mongodb://localhost:27017
#   Cloudflare/production: a hosted MongoDB such as Atlas (mongodb+srv://...)
MONGO_URL=

# Name of the MongoDB database that holds the `resources` and `leads` collections.
DB_NAME=

# Password for the /admin/login page and all /api/admin/* endpoints (server-side only).
# Use a long random value. Do not reuse the one from the Emergent export.
ADMIN_PASSWORD=

# Value sent in the Access-Control-Allow-Origin header (read at build time by next.config.js).
# "*" allows any origin; set to your site origin (e.g. https://therapidrevenue.in) for production.
CORS_ORIGINS=

# Present in the Emergent export but not read anywhere in the code. Optional.
NEXT_PUBLIC_BASE_URL=
